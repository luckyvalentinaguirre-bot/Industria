{
  "_comment": "Industria V1 - recetas. inputs/outputs en {id: cantidad}. time = segundos de juego por ciclo.",
  "recipes": {
    "craft_handtool": {
      "name": "Fabricar herramienta manual",
      "machine": "workbench",
      "time": 7.0,
      "inputs": { "scrap": 4 },
      "outputs": { "hand_tool": 1 }
    },
    "cut_planks": {
      "name": "Aserrar tablas",
      "machine": "sawmill",
      "time": 5.0,
      "inputs": { "wood_log": 2 },
      "outputs": { "plank": 3 }
    },
    "make_pallet": {
      "name": "Armar pallet",
      "machine": "planer",
      "time": 7.0,
      "inputs": { "plank": 4 },
      "outputs": { "pallet": 1 }
    },
    "refine_fuel": {
      "name": "Refinar combustible",
      "machine": "refinery",
      "time": 6.0,
      "inputs": { "oil": 3 },
      "outputs": { "fuel": 2 }
    },
    "fire_brick": {
      "name": "Cocer ladrillos",
      "machine": "brick_kiln",
      "time": 5.0,
      "inputs": { "clay": 2 },
      "outputs": { "brick": 5 }
    },
    "make_block": {
      "name": "Fabricar bloque",
      "machine": "block_press",
      "time": 6.0,
      "inputs": { "brick": 4 },
      "outputs": { "block": 1 }
    },
    "grow_regulated": {
      "name": "Cultivo regulado",
      "machine": "grow_module",
      "time": 9.0,
      "inputs": { "nutrients": 3 },
      "outputs": { "regulated_goods": 1 }
    },
    "smelt_iron": {
      "name": "Fundir hierro",
      "machine": "smelter",
      "time": 6.0,
      "inputs": { "iron_ore": 2 },
      "outputs": { "iron_ingot": 1 }
    },
    "smelt_copper": {
      "name": "Fundir cobre",
      "machine": "smelter",
      "time": 6.0,
      "inputs": { "copper_ore": 2 },
      "outputs": { "copper_ingot": 1 }
    },
    "recycle_scrap": {
      "name": "Reciclar chatarra",
      "machine": "smelter",
      "time": 5.0,
      "inputs": { "scrap": 3 },
      "outputs": { "recycled_metal": 1 }
    },
    "press_plate": {
      "name": "Prensar placa metalica",
      "machine": "press",
      "time": 5.0,
      "inputs": { "iron_ingot": 1 },
      "outputs": { "metal_plate": 1 }
    },
    "make_copper_part": {
      "name": "Fabricar componente de cobre",
      "machine": "press",
      "time": 6.0,
      "inputs": { "copper_ingot": 1 },
