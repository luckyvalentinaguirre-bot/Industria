    },
    "make_industrial_part": {
      "name": "Fabricar pieza industrial",
      "machine": "assembler",
      "time": 8.0,
      "inputs": { "metal_plate": 1, "recycled_metal": 1 },
      "outputs": { "industrial_part": 1 }
    },
    "assemble_metal_piece": {
      "name": "Ensamblar pieza metalica",
      "machine": "assembler",
      "time": 8.0,
      "inputs": { "metal_plate": 2 },
      "outputs": { "metal_piece": 1 }
    },
    "assemble_industrial_comp": {
      "name": "Ensamblar componente industrial",
      "machine": "assembler",
      "time": 10.0,
      "inputs": { "industrial_part": 1, "copper_part": 1 },
      "outputs": { "industrial_comp": 1 }
    },
    "assemble_motor": {
      "name": "Ensamblar motor simple",
      "machine": "assembler",
      "time": 14.0,
      "inputs": { "industrial_comp": 1, "copper_part": 2, "fuel": 1 },
      "outputs": { "simple_motor": 1 }
    }
  }
