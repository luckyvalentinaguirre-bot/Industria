; Engine configuration file.
; Industria — Godot 4.x project
; VERSION 1 (MVP)

config_version=5

[application]

config/name="Industria"
config/description="Gestión empresarial + construcción de fábricas + producción + automatización progresiva. VERSION 1 (MVP)."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameState="*res://scripts/core/game_state.gd"
TimeManager="*res://scripts/core/time_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

